# ── Formicary connection ──────────────────────────────────────────────────────
# Get your API token from: https://<queen-host>/dashboard/users/self → API Tokens
FORMICARY_URL=https://your-queen-ip.nip.io
FORMICARY_TOKEN=<your-formicary-api-token>

# ── GitHub ────────────────────────────────────────────────────────────────────
GH_ORG=your-github-org
GH_REPO=your-github-repo
GH_TOKEN=<github_pat_...>

# SSH private key content (used for git clone/push in implement jobs)
# Export as: export SSH_PRIVATE_KEY=$(cat ~/.ssh/id_ed25519)
SSH_PRIVATE_KEY=<contents of your private key>

# ── Jira / Bitbucket (skip if using GitHub only) ─────────────────────────────
JIRA_EMAIL=you@example.com
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_API_TOKEN=<your-jira-api-token>
JIRA_BOARDS=<your-board-id>

BITBUCKET_WORKSPACE=your-workspace
BITBUCKET_REPO=your-repo
BITBUCKET_USERNAME=you@example.com
BITBUCKET_TOKEN=<your-bitbucket-token>

# ── Slack bot token ───────────────────────────────────────────────────────────
# Used by job scripts to post results back to the Slack thread.
# xoxb-... bot token only — SLACK_APP_TOKEN is server-side only, not needed here.
SLACK_BOT_TOKEN=<xoxb-...>
SLACK_CHANNEL=your-slack-channel

# ── Claude / Bedrock (choose one) ─────────────────────────────────────────────
# Option A: Tailscale Bedrock proxy (default — no extra credentials needed)
#   CLAUDE_CODE_USE_BEDROCK=1
#   ANTHROPIC_BEDROCK_BASE_URL=http://ai/bedrock
#
# Option B: Direct Anthropic API
#   ANTHROPIC_API_KEY=<sk-ant-...>
#
# Option C: AWS credentials for Bedrock (if not using Tailscale proxy)
#   AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
#   AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
#   AWS_SESSION_TOKEN=<your-aws-session-token>
