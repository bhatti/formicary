# Formicary server
QUEEN_IP=10.8.97.24
QUEEN_SSH_KEY=$HOME/Downloads/your-key.pem
QUEEN_SSH_USER=ec2-user
FORMICARY_URL=https://${QUEEN_IP}.nip.io
FORMICARY_TOKEN=<your-formicary-api-token>

# GitHub
GH_ORG=your-github-org
GH_REPO=your-github-repo
GH_TOKEN=<github_pat_...>
GITHUB_TOKEN=<github_pat_...>

# Jira / Bitbucket
JIRA_EMAIL=you@example.com
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_HOST=your-org.atlassian.net
JIRA_API_TOKEN=<your-jira-api-token>
JIRA_BOARDS=<your-board-id>

BITBUCKET_WORKSPACE=your-workspace
BITBUCKET_REPO=your-repo
BITBUCKET_USERNAME=you@example.com
BITBUCKET_TOKEN=<your-bitbucket-token>

# Slack
SLACK_CHANNEL=your-slack-channel
SLACK_BOT_TOKEN=<xoxb-...>
SLACK_APP_TOKEN=<xapp-...>
SLACK_SIGNING_SECRET=<your-signing-secret>

# SSH key for git operations (content of private key, not path)
SSH_PRIVATE_KEY=<contents of ~/.ssh/id_ed25519>

# AWS (for Bedrock proxy — optional if using Tailscale http://ai/bedrock)
AWS_ACCESS_KEY_ID=<your-aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<your-aws-secret-access-key>
AWS_SESSION_TOKEN=<your-aws-session-token>
