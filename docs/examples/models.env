#!/usr/bin/env bash
# models.env — canonical Claude model IDs for all Formicary AI workflows.
#
# This is the single source of truth for model version defaults.
# Update here to roll all workflows to a new model version.
#
# Usage:
#   source ./models.env   (done automatically by deploy-ai-workflows.sh and
#                          deploy-ai-jira-workflows.sh)
#   Override at runtime:  ANTHROPIC_SONNET_MODEL=us.anthropic.claude-sonnet-5 ./deploy-ai-workflows.sh ...
#
# The deploy scripts push these as Formicary org configs (AnthropicSonnetModel,
# AnthropicOpusModel, AnthropicHaikuModel), which override the YAML job_variables
# defaults at runtime.  The YAML defaults are last-resort fallbacks only.
#
# Available Bedrock models on Aperture proxy:
#   us.anthropic.claude-haiku-4-5-20251001-v1:0   haiku (fast, cheap)
#   us.anthropic.claude-sonnet-4-6                sonnet 4.6
#   us.anthropic.claude-sonnet-5                  sonnet 5 (latest)
#   us.anthropic.claude-opus-4-6-v1               opus 4.6
#   us.anthropic.claude-opus-5                    opus 5 (latest)
#   anthropic.claude-fable-5                      fable 5 (via isolated-DR)
#   anthropic.claude-sonnet-5                     sonnet 5 (via Mantle)
#   anthropic.claude-opus-5                       opus 5 (via Mantle)

ANTHROPIC_SONNET_MODEL="${ANTHROPIC_SONNET_MODEL:-us.anthropic.claude-sonnet-4-6}"
ANTHROPIC_OPUS_MODEL="${ANTHROPIC_OPUS_MODEL:-us.anthropic.claude-opus-4-6-v1}"
ANTHROPIC_HAIKU_MODEL="${ANTHROPIC_HAIKU_MODEL:-us.anthropic.claude-haiku-4-5-20251001-v1:0}"

# Complexity-tiered model selection for implement tasks.
# plan task writes plan_complexity.txt (low/medium/high); implement reads it.
# low   → Haiku (simple tasks, fast/cheap)
# medium→ Sonnet (default, set via AnthropicSonnetModel)
# high  → Opus  (complex architecture changes)
ANTHROPIC_COMPLEXITY_LOW_MODEL="${ANTHROPIC_COMPLEXITY_LOW_MODEL:-${ANTHROPIC_HAIKU_MODEL}}"
ANTHROPIC_COMPLEXITY_HIGH_MODEL="${ANTHROPIC_COMPLEXITY_HIGH_MODEL:-${ANTHROPIC_OPUS_MODEL}}"
